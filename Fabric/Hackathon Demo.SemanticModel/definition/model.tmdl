model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["customer_group","revenue","sales","sales_plan"]

ref table customer_group
ref table revenue
ref table sales
ref table sales_plan

ref cultureInfo en-GB

